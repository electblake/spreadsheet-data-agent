{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spreadsheet-data-agent:summarize-sheet:sheet-manifest:1",
  "title": "Summarize Sheet Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "schema_version",
    "artifact_id",
    "reporting_date",
    "source",
    "selection",
    "files"
  ],
  "properties": {
    "$schema": {
      "const": "../../../.agents/skills/summarize-sheet/assets/sheet-manifest.schema.json"
    },
    "schema": {
      "const": "summarize-sheet.manifest"
    },
    "schema_version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "reporting_date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "size_bytes"],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sheet"],
      "properties": {
        "mode": {
          "enum": ["first", "named"]
        },
        "sheet": {
          "type": ["string", "null"]
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "filename", "media_type", "sha256", "size_bytes"],
        "properties": {
          "role": {
            "enum": ["summary_markdown", "company_markdown", "model_context", "sheet_ndjson"]
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "enum": ["text/markdown", "text/plain", "application/x-ndjson"]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
